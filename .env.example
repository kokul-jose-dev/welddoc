AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=weldoc;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
FLASK_ENV=development
FLASK_DEBUG=1

# Local development only (debug mode): the user you are logged in as automatically
DEV_USER_EMAIL=
DEV_USER_NAME=

# Global WAZ folder: every WAZ certificate uploaded at project level is also kept here, under
# the same file name. Host / site default to SHAREPOINT_HOST / SHAREPOINT_SITE_PATH.
# Leave the folder empty to switch it off.
SHAREPOINT_GLOBAL_WAZ_HOST=
SHAREPOINT_GLOBAL_WAZ_SITE=
SHAREPOINT_GLOBAL_WAZ_FOLDER=

