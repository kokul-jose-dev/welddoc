AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:YOUR_SERVER.database.windows.net,1433;Database=weldoc;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;
FLASK_ENV=development
FLASK_DEBUG=1

# Local development only (debug mode): the user you are logged in as automatically
DEV_USER_EMAIL=
DEV_USER_NAME=
